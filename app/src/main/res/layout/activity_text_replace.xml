<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متن اصلی"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="8"
            android:gravity="top|start"
            android:layout_marginTop="8dp"
            android:hint="متنی که می‌خوای روش تغییر اعمال بشه رو اینجا بچسبون..." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کلماتی که باید حذف بشن (هرکدوم یه خط)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtWordsToRemove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:gravity="top|start"
            android:layout_marginTop="8dp"
            android:hint="سلام&#10;خداحافظ" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="کلمات جایگزین (به همون ترتیب، هرکدوم یه خط؛ خالی بذار یعنی فقط حذف بشه)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/edtWordsReplacement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:gravity="top|start"
            android:layout_marginTop="8dp"
            android:hint="درود&#10;بدرود" />

        <Button
            android:id="@+id/btnApplyReplace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اعمال کن" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="نتیجه:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="8"
            android:gravity="top|start"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
