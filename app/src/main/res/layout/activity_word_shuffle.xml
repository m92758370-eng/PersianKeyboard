<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اضافه کردن کلمه به‌صورت دستی"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edtManualWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="یه کلمه بنویس..." />

            <Button
                android:id="@+id/btnAddWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اضافه کن" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="بارگذاری فایل متنی کلمات" />

        <TextView
            android:id="@+id/txtWordCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تعداد کلمات فعلی: 0" />

        <Button
            android:id="@+id/btnClearWords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="پاک کردن لیست فعلی" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ذخیره لیست فعلی"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edtWordListName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="اسم این لیست..." />

            <Button
                android:id="@+id/btnSaveWordList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذخیره" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لیست‌های ذخیره‌شده (انتخاب کن تا ترکیب بشن)"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/savedListsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnCombineSelected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="اضافه کردن انتخاب‌شده‌ها به لیست فعلی" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33000000"
            android:layout_marginVertical="16dp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تولید پاراگراف" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="نتیجه (کلمات با خط قرمز رو می‌تونی دستی اصلاح کنی):"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="10"
            android:gravity="top|start"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
